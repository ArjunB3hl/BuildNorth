require 'pathname'
# Expo Modules autolinking (experimental on macOS):
# https://microsoft.github.io/react-native-macos/docs/guides/installing-expo-modules
require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")

ws_dir = Pathname.new(__dir__)
ws_dir = ws_dir.parent until
  File.exist?("#{ws_dir}/node_modules/react-native-macos/scripts/react_native_pods.rb") ||
  ws_dir.expand_path.to_s == '/'
require "#{ws_dir}/node_modules/react-native-macos/scripts/react_native_pods.rb"

prepare_react_native_project!

target 'NorthAssistant-macOS' do
  platform :macos, '14.0'
  # Links the Expo modules that support macOS (see "expo.autolinking" in package.json)
  # plus the local ones in ../modules.
  use_expo_modules!

  config_command = [
    'npx',
    'expo-modules-autolinking',
    'react-native-config',
    '--json',
    '--platform',
    'ios'
  ]
  config = use_native_modules!(config_command)

  # Flags change depending on the env values.
  flags = get_default_flags()

  use_react_native!(
    :path => "#{config[:reactNativePath]}-macos",
    :fabric_enabled => ENV['RCT_NEW_ARCH_ENABLED'] == '1',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(installer)

    # Expo podspecs declare macOS 11.0, which Xcode 27 no longer accepts (its minimum is
    # 12.0). Their resource-bundle targets keep that value, so lift every pod to the app's 14.0.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        current = build_config.build_settings['MACOSX_DEPLOYMENT_TARGET']
        if current.nil? || Gem::Version.new(current) < Gem::Version.new('14.0')
          build_config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '14.0'
        end
      end
    end
  end
end
