# Copy to .env and fill in. Only EXPO_PUBLIC_* values belong here: Expo CLI bundles them into the app, so
# never put secrets in this file. Restart `npm start` after changing it.

# Clerk Dashboard -> API keys -> Publishable key (pk_test_... / pk_live_...), the same as the phone app's.
# Without it the app can't sign in and stays on local demo data.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key

# The Rhythm API. Default: http://localhost:8000 (a backend on this PC, mobile/backend).
# The deployed API: https://buildnorth.onrender.com
EXPO_PUBLIC_API_URL=

# The Rhythm website, for links (AI connections, creating an account). Default: https://rhythm-buildnorth.expo.app
EXPO_PUBLIC_WEB_URL=

# Development only, in .env.local: a session token from the local test backend (tools/local-backend/serve.py)
# instead of a Clerk sign-in. Leave unset otherwise; release bundles ignore it.
# EXPO_PUBLIC_DEV_SESSION_TOKEN=
