# Copy to .env and fill in. Only EXPO_PUBLIC_* values belong here: they are
# bundled into the app, so never put secret keys in this file.

# Clerk Dashboard -> API keys -> Publishable key (pk_test_... / pk_live_...)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Optional. Base URL of the BuildNorth backend. Leave empty to use the machine
# running `expo start` on port 8000 (works in Expo Go on the same Wi-Fi). For a physical
# iPhone on another network, use the backend's public HTTPS tunnel, e.g. https://<your-domain>.ngrok-free.dev
EXPO_PUBLIC_API_URL=

# Public website for native-app handoff to browser voice Coach. Leave blank before deployment.
EXPO_PUBLIC_WEB_APP_URL=
# Real HTTPS release/store links only. Empty values show setup guidance instead of a fake download.
EXPO_PUBLIC_DOWNLOAD_WINDOWS_URL=
EXPO_PUBLIC_DOWNLOAD_MAC_URL=
EXPO_PUBLIC_DOWNLOAD_ANDROID_URL=
EXPO_PUBLIC_DOWNLOAD_IPHONE_URL=
