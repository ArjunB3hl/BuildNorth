{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "buildnorth": {
      "type": "remote",
      "url": "http://localhost:8000/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:BUILDNORTH_MCP_TOKEN}"
      },
      "timeout": 15000
    }
  }
}
