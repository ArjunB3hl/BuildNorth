{
  "expo": {
    "name": "Rhythm",
    "slug": "BuildNorth",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "buildnorth",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.arjun273773.buildnorth"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.arjun273773.buildnorth"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Rhythm · Demo version",
      "shortName": "Rhythm",
      "description": "Demo version of Rhythm, your companion for meals, movement and everyday routines."
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      "@bacons/apple-targets",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.arjun273773.buildnorth.watch",
                  "targetName": "watch",
                  "entitlements": {
                    "com.apple.developer.healthkit": true,
                    "com.apple.developer.healthkit.access": []
                  }
                }
              ]
            }
          }
        },
        "projectId": "09d1e081-f14e-4acf-b420-029271bb27ef"
      }
    },
    "owner": "arjun273773"
  }
}
