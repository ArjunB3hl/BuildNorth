# Paste values into Render > your backend Web Service > Environment.
# These are placeholders, not working credentials. Never commit filled-in secrets.
ANTHROPIC_API_KEY=replace-with-your-shared-demo-key
AI_PROVIDER=auto
AI_MODEL=claude-opus-5-5
CLERK_PUBLISHABLE_KEY=replace-with-the-same-publishable-key-as-the-website
DATABASE_URL=replace-with-render-postgres-internal-database-url
# Generate once with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Save in your password manager as well; keep it stable across deploys.
AI_CREDENTIAL_ENCRYPTION_KEY=replace-with-generated-fernet-key
AUTO_MIGRATE=false
WEB_ALLOWED_ORIGINS=https://your-website.example
CLERK_AUTHORIZED_PARTIES=https://your-website.example
# MCP_PUBLIC_URL defaults to the Render backend URL + /mcp. Set it for a custom API domain.
# MCP_PUBLIC_URL=https://your-backend.example/mcp
# Optional memory, YouTube and other settings are listed in .env.example.
