# Copy to backend/.env and fill in. Server-side only; never commit the real file.

# SurrealDB Agent Memory (Studio -> your context -> API keys).
# The context host and context ID are not the context's display name.
SPECTRON_URL=https://your-context-host
SPECTRON_CONTEXT_ID=your-context-id
SPECTRON_API_KEY=sp-your-secret-key

# Clerk publishable key (same value as the app's EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY).
# Public; used to locate Clerk's JWKS for verifying session tokens.
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Optional, comma-separated. If set, tokens carrying an `azp` claim must match
# one of these origins (relevant for web clients; native tokens omit `azp`).
CLERK_AUTHORIZED_PARTIES=

# App records. Default: SQLite at backend/var/buildnorth.db (local development).
# Production: any SQLAlchemy URL, e.g. postgresql+psycopg://user:pass@host/db
# (install the driver and run `alembic upgrade head` on deploy, with AUTO_MIGRATE=false).
DATABASE_URL=
AUTO_MIGRATE=true

# AI provider for coaching and recipe/routine extraction: none | ollama | openai | anthropic
#   ollama:    local models (default model gemma3:4b, default URL http://localhost:11434)
#   openai:    any OpenAI-compatible Chat Completions endpoint; needs AI_MODEL and usually AI_API_KEY
#   anthropic: Claude; needs AI_API_KEY (or ANTHROPIC_API_KEY); default model claude-opus-5-5
AI_PROVIDER=none
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=150

# --- MCP endpoint for external assistants (OpenCode, ChatGPT, Claude) ------------------------
# Served at /mcp on this backend. MCP_PUBLIC_URL must be the exact URL clients connect to
# (for a tunnel or deployment, e.g. https://your-host.example.com/mcp). Default: http://localhost:8000/mcp
MCP_PUBLIC_URL=
# Extra Host headers allowed at /mcp, comma-separated (localhost and MCP_PUBLIC_URL's host are always allowed).
MCP_ALLOWED_HOSTS=
# true: an approval the user gives in the assistant's own approval prompt (MCP elicitation) can apply a
# proposal. false: proposals are applied only after approval in the BuildNorth app.
MCP_CLIENT_APPROVAL=true
# Clerk OAuth at /mcp (ChatGPT, Claude). Tokens must be RFC 9068 JWTs (typ at+jwt) from this Clerk instance,
# for a client whose CIMD client_id URL is on one of these hosts (or listed exactly in MCP_OAUTH_CLIENT_IDS),
# and with `aud` naming MCP_PUBLIC_URL. Set MCP_REQUIRE_RESOURCE_AUDIENCE=false only if Clerk can't bind `aud`
# to the resource; the client allow-list is then the only binding.
MCP_OAUTH_CLIENT_HOSTS=chatgpt.com,claude.ai,claude.com
MCP_OAUTH_CLIENT_IDS=
MCP_REQUIRE_RESOURCE_AUDIENCE=true
# Optional. Only needed if the Clerk instance issues *opaque* OAuth access tokens (JWT tokens, the
# default for new Clerk apps, are verified with the public JWKS). Server-side only.
CLERK_SECRET_KEY=
