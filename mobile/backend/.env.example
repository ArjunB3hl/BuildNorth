# Copy to backend/.env and fill in. Server-side only; never commit the real file.

# Personal Claude keys for the demo Coach are encrypted at rest. Set a persistent Fernet key in production:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Local SQLite creates a mode-0600 ai-credentials.key beside the DB when this is empty.
# Keep that file with your database backup; changing/lost keys requires users to reconnect.
AI_CREDENTIAL_ENCRYPTION_KEY=
# Comma-separated deployed website origins (no paths), e.g. https://buildnorth.example.com.
# Localhost origins are already allowed. Never use * with account-owned keys/data.
WEB_ALLOWED_ORIGINS=

# SurrealDB Agent Memory (Studio -> your context -> API keys).
# The context host and context ID are not the context's display name.
SPECTRON_URL=https://your-context-host
SPECTRON_CONTEXT_ID=your-context-id
SPECTRON_API_KEY=sp-your-secret-key
# Optional explicit owner of this Context. Enables Rhythm to reuse these credentials for that
# account and prevents all other app accounts from using this default Context.
SPECTRON_OWNER_USER_ID=

# Clerk publishable key (same value as the app's EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY).
# Public; used to locate Clerk's JWKS for verifying session tokens.
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Optional, comma-separated. If set, tokens carrying an `azp` claim must match
# one of these origins (relevant for web clients; native tokens omit `azp`).
CLERK_AUTHORIZED_PARTIES=

# App records. Default: SQLite at backend/var/buildnorth.db (local development).
# Production: any SQLAlchemy URL, e.g. postgresql+psycopg://user:pass@host/db
# (install the driver and run `alembic upgrade head` on deploy, with AUTO_MIGRATE=false).
DATABASE_URL=
AUTO_MIGRATE=true

# Shared Claude for signed-in demo users. Server-only: never put this key in EXPO_PUBLIC_*.
# AI_PROVIDER=auto detects this key. A user's personal Claude key takes priority; removing it restores the demo.
# ChatGPT/Claude MCP connections use the assistant's own model and do not replace the in-app provider.
ANTHROPIC_API_KEY=

# AI provider for coaching and recipe/routine extraction: auto | none | ollama | openai | anthropic
#   auto:      use ANTHROPIC_API_KEY when present, otherwise no provider. Explicit none disables shared AI.
#   ollama:    local models (default model gemma3:4b, default URL http://localhost:11434)
#   openai:    any OpenAI-compatible Chat Completions endpoint; needs AI_MODEL and usually AI_API_KEY
#   anthropic: Claude; needs AI_API_KEY (or ANTHROPIC_API_KEY); default model claude-opus-5-5
AI_PROVIDER=auto
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=150

# Default voice: Parakeet STT -> existing Claude Coach -> Kokoro TTS (separate private service).
# A verified account ElevenLabs agent is the only override for the speech provider.
# Leave blank until inference/speech-worker is deployed. Never expose this token in EXPO_PUBLIC_*.
SPEECH_WORKER_URL=
SPEECH_WORKER_TOKEN=

# --- MCP endpoint for external assistants (ChatGPT, Claude, ElevenLabs) ----------------------
# Served at /mcp on this backend. MCP_PUBLIC_URL must be the exact URL clients connect to
# (e.g. https://your-host.example.com/mcp). Defaults to RENDER_EXTERNAL_URL/mcp on Render, localhost:8000/mcp locally.
MCP_PUBLIC_URL=
# Extra Host headers allowed at /mcp, comma-separated (localhost and MCP_PUBLIC_URL's host are always allowed).
MCP_ALLOWED_HOSTS=
# true: an approval the user gives in the assistant's own approval prompt (MCP elicitation) can apply a
# proposal. false: proposals are applied only after approval in the BuildNorth app.
MCP_CLIENT_APPROVAL=true
# Clerk OAuth at /mcp (ChatGPT, Claude). Tokens must be RFC 9068 JWTs (typ at+jwt) from this Clerk instance,
# for a client whose CIMD client_id URL is on one of these hosts (or listed exactly in MCP_OAUTH_CLIENT_IDS),
# and with `aud` naming MCP_PUBLIC_URL. Set MCP_REQUIRE_RESOURCE_AUDIENCE=false only if Clerk can't bind `aud`
# to the resource; the client allow-list is then the only binding.
MCP_OAUTH_CLIENT_HOSTS=chatgpt.com,claude.ai,claude.com
MCP_OAUTH_CLIENT_IDS=
MCP_REQUIRE_RESOURCE_AUDIENCE=true
# Optional. Only needed if the Clerk instance issues *opaque* OAuth access tokens (JWT tokens, the
# default for new Clerk apps, are verified with the public JWKS). Server-side only.
CLERK_SECRET_KEY=

# --- Rhythm video companion ---------------------------------------------------------------
# Video tasks, page grants, search and recommendations (REST and MCP). Off unless set to on; learning, reactions and
# the interest profile work either way. Turn on together with RECOMMENDATIONS_ENABLED in mobile/src/lib/rhythm.ts.
RHYTHM_RECOMMENDATIONS=
# Dedicated MCP resource. Defaults to MCP_PUBLIC_URL's origin plus /rhythm/mcp.
RHYTHM_MCP_PUBLIC_URL=
# YouTube Data API v3. Backend-only. No API key is needed for permitted selected-page metadata.
YOUTUBE_API_KEY=
RHYTHM_CANDIDATES_PER_TASK=10
RHYTHM_SHORTLIST_PER_TASK=3
RHYTHM_ATTEMPTS_PER_TASK=3
RHYTHM_ATTEMPTS_PER_DAY=10
RHYTHM_SEARCHES_PER_DAY=20
RHYTHM_TASK_MINUTES=30
RHYTHM_CACHE_HOURS=24
RHYTHM_BUDGET_TIMEZONE=America/Toronto
# Optional additional private Agent Memory Contexts: ONE distinct Context per authenticated Clerk user.
# SPECTRON_OWNER_USER_ID automatically binds the existing SPECTRON_* credentials to its account.
# Leave this map empty if that is your only user; other accounts remain unbound.
# Only the explicitly declared owner may reference SPECTRON_CONTEXT_ID in this map.
# Server-only JSON; populate privately from your secret manager or local ignored env file:
# {"user_REPLACE":{"contextId":"private-context-id","apiKey":"private-context-key","endpoint":"https://your-context-host"}}
RHYTHM_MEMORY_CONTEXTS_JSON=
