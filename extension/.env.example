# Public build configuration only. Never put a YouTube, model, Clerk secret or memory API key here.
WXT_API_URL=http://localhost:8000
WXT_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_public_key
WXT_CLERK_FRONTEND_API=https://your-instance.clerk.accounts.dev
# Optional public CRX key for a stable extension ID. Configure that ID in Clerk.
WXT_CRX_PUBLIC_KEY=
# A phone deep link; optionally use your deployed Expo web profile URL.
WXT_PROFILE_URL=buildnorth://profile/interests
# Web app origin, used for dashboard and interests links. HTTPS except on localhost.
WXT_WEB_APP_URL=http://localhost:8081
