# Pinned sources and versions for the MiniCPM-o 4.5 deployment (verified 2026-10-22). Shell-sourceable; also read by
# the Docker build (as build args), the model staging script and preflight.

# Model: openbmb/MiniCPM-o-4_5 (Apache-2.0, not gated), main @ 2026-10-16 "Update README.md".
MODEL_ID=openbmb/MiniCPM-o-4_5
MODEL_REVISION=d59117d19ddb8a28a62f1b5f4e3b34ac48d510a4
# 54 files, 20,048,635,793 bytes (bf16 safetensors 18.74 GB + assets/token2wav 1.23 GB + tokenizer/config/code/media)
MODEL_TOTAL_BYTES=20048635793

# Serving code: OpenBMB/MiniCPM-o-Demo main @ 2026-09-15 (PyTorch backend, py_backend.server + worker.py + gateway.py).
DEMO_REPO=https://github.com/OpenBMB/MiniCPM-o-Demo.git
DEMO_COMMIT=47709a9210dfd71afa76c058e017fc8c4db5c8d2
DEMO_COMMIT_DATE=2026-09-15T07:16:25Z

# Runtime: the demo's container stack (python:3.12-slim-bookworm + torch 2.8.0 CUDA 12.8 wheels). The base image is
# pinned by its multi-arch index digest (Docker Hub, 2026-10-21: python:3.12.15-slim-bookworm).
BASE_IMAGE=python:3.12.15-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70
PYTHON_VERSION=3.12.15
TORCH_VERSION=2.8.0
CUDA_RUNTIME=12.8
# CUDA 12.8 user-space libraries come from the torch wheels; the host driver must support CUDA 12.8 (R570 or newer).
MIN_DRIVER_MAJOR=570

# Image
IMAGE_NAME=ghcr.io/arjunb3hl/rhythm-minicpm-o
IMAGE_VERSION=0.1.3
