# Rhythm MiniCPM-o deployment: every setting, with placeholders only. Copy to .env (git-ignored) on the machine that
# runs the command, or set the value in the secret store named next to it. Never commit real values.

# --- 1. Staging (stage_model.py in GitHub Actions reads 1a/1b from repository secrets; stage_clips.py on the Mac reads
#        all four from this file) ---------------------------------------------------------------------------------------
RUNPOD_S3_ACCESS_KEY_ID=user_xxxxxxxxxxxxxxxxxxxxxxxxxxx      # 1a. Runpod Settings -> S3 API Keys (your user id)
RUNPOD_S3_SECRET_ACCESS_KEY=rps_xxxxxxxxxxxxxxxxxxxxxxxxxxxx  # 1b. shown once when the S3 key is created
RUNPOD_VOLUME_ID=xxxxxxxxxx                                   # Storage -> the network volume's id (= S3 bucket)
RUNPOD_DATACENTER=US-WA-1                                     # the volume's data centre (= S3 region)
MOTION_LIBRARY_REPO=                                          # your private Hugging Face dataset with the motion-library clips (owner/name)

# --- 2. Runpod control (runpod/rp.sh; run from any machine, small API calls only) -----------------------------------
RUNPOD_API_KEY=rpa_xxxxxxxxxxxxxxxxxxxxxxxxxxxx               # Runpod Settings -> API Keys (read/write)
IMAGE_REF=ghcr.io/arjunb3hl/rhythm-minicpm-o@sha256:DIGEST   # from the image workflow's job summary
RUNPOD_REGISTRY_AUTH_ID=xxxxxxxx                              # Settings -> Container Registry Auth (GHCR, read:packages PAT)
# RUNPOD_TEMPLATE_ID is written to runpod/.template-id by `rp.sh template` (create reads it from there)
# RUNPOD_GPU_TYPES="NVIDIA RTX 6000 Ada Generation"  # optional: override pod.json's GPU order
# READY_TIMEOUT_S=2400               # optional: rp.sh wait-ready limit (use >= 3600 with TORCH_COMPILE=1)

# --- 3. Inside the Pod (template env; defaults are baked into the image, override only with a reason) ----------------
# RHYTHM_API_TOKEN={{ RUNPOD_SECRET_rhythm_api_token }}   # REQUIRED, set in template.json: a Runpod secret holding
#                                                         # `openssl rand -hex 32`; never a literal value. A secret
#                                                         # named RUNPOD_SECRET_RHYTHM_API_TOKEN is also accepted
# MODEL_DIR=/workspace/models/openbmb/MiniCPM-o-4_5/d59117d19ddb8a28a62f1b5f4e3b34ac48d510a4
# MODEL_VERIFY=size                # size (default) | sha256 (hash all 20 GB at start, ~1-2 min) | off
# ATTN_IMPLEMENTATION=sdpa         # sdpa | eager | auto (flash_attention_2 is not installed)
# TORCH_COMPILE=0                  # 1 = faster per-unit inference after a ~15 min first compile (cached on the volume);
#                                  #     raises the BACKEND_READY_TIMEOUT_S default to 2700
# WARMUP=1                         # 0 = report ready once loaded, without the warm-up request
# WARMUP_TIMEOUT_S=180
# BACKEND_READY_TIMEOUT_S=900      # model load limit before the container gives up (2700 with TORCH_COMPILE=1)
# RHYTHM_ON_FAILURE=exit           # hold = keep the container (SSH, and Caddy if started) up after a failure (GPU billed)
# RHYTHM_MAX_QUEUE=4               # sessions waiting for the single worker
# RHYTHM_REQUEST_TIMEOUT_S=300     # internal gateway->worker request timeout (not the 300 s video session cap)
# RHYTHM_RECORD_SESSIONS=0         # 1 = let the demo record sessions to /workspace/rhythm/data (privacy: off)
# MIN_VRAM_GB=40
# RHYTHM_MIN_FREE_GB=2

# --- 4. Rhythm app / probe client ------------------------------------------------------------------------------------
RHYTHM_ENDPOINT=                                              # https://POD_ID-8000.proxy.runpod.net (WebSocket: wss://POD_ID-8000.proxy.runpod.net/v1/realtime)
RHYTHM_API_TOKEN=                                             # the same value as the Runpod secret; sent as "Authorization: Bearer TOKEN"
