# MiniCPM-o 4.5 PyTorch streaming backend (OpenBMB/MiniCPM-o-Demo @ 47709a92, py_backend + worker + gateway).
# Mirrors the demo's docker/Dockerfile.worker-backend + requirements.txt (runtime only; pytest dropped), with every
# version pinned. Resolved for Linux x86_64 / CPython 3.12 into requirements.lock by lock.sh. Do not add packages
# from another inference backend (vLLM, SGLang, llama.cpp bindings) to this file.

# PyTorch stack: the demo installs these from the cu128 index; torch 2.8.0's PyPI Linux x86_64 wheel is the same
# CUDA 12.8 build (it pulls the nvidia-*-cu12 12.8 runtime wheels), so the lock uses PyPI.
torch==2.8.0
torchaudio==2.8.0

